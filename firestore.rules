rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }
    match /admins/{uid} { allow read: if isOwner(uid) || isAdmin(); allow write: if isAdmin(); }
    match /masters/{id} { allow read: if true; allow write: if isAdmin(); }
    match /services/{id} { allow read: if true; allow write: if isAdmin(); }
    match /schedules/{id} { allow read: if true; allow write: if isAdmin(); }
    match /slotLocks/{id} {
      allow read: if true;
      allow create: if signedIn() && !exists(/databases/$(database)/documents/slotLocks/$(id)) && (request.resource.data.masterId is string) && (request.resource.data.time is string);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /appointments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.clientId == request.auth.uid) || (signedIn() && resource.data.masterUserId == request.auth.uid);
      allow create: if signedIn() && (
        request.resource.data.clientId == request.auth.uid ||
        isAdmin() ||
        request.resource.data.masterUserId == request.auth.uid
      );
      allow update, delete: if isAdmin() || (signedIn() && resource.data.clientId == request.auth.uid) || (signedIn() && resource.data.masterUserId == request.auth.uid);
    }
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.clientId == request.auth.uid);
    }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
  }
}
